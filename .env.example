# 데이터베이스 (docker-compose up -d postgres 실행 시 기본값과 일치)
DATABASE_URL=postgresql://doit:doit@localhost:5432/doit_agent

# LLM — OpenAI 호환 API (LLM_BASE_URL을 바꾸면 다른 호환 서비스로 교체)
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Phase 2 — LLM-as-a-Judge (기본값: 활성, 답변 모델과 동일한 모델)
# JUDGE_ENABLED=true
# JUDGE_MODEL=

# Langfuse 관측 (기본값: 비활성 — 키를 입력하고 LANGFUSE_ENABLED=true)
# LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
